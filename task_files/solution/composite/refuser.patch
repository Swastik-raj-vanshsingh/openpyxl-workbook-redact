-# Functions that address cells by text or by position rather than by reference.
-# A tokenizer cannot see through them: INDIRECT("B2") names the removed column
-# in a string, and VLOOKUP(..., 2, ...) names it by its place in a range that is
-# about to lose a column. The first kind cannot be checked at all; the second
-# kind is checked against the ranges the formula does name.
-OPAQUE_FUNCTIONS = {"INDIRECT", "OFFSET", "ADDRESS"}
-POSITIONAL_FUNCTIONS = {"VLOOKUP", "HLOOKUP", "INDEX", "MATCH", "LOOKUP", "CHOOSE", "COLUMN", "COLUMNS"}
