-def _publish(wb, destination: Path) -> None:
-    """Write next to the destination, then claim the name without replacing anything."""
-    temporary = destination.with_name(".%s.part" % destination.name)
-    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0)
-    fd = os.open(str(temporary), flags, 0o644)
-    try:
-        with os.fdopen(fd, "wb") as handle:
-            wb.save(handle)
-        if os.path.lexists(destination):
-            raise RedactionRefused("a file is already at the destination")
-        os.link(str(temporary), str(destination), follow_symlinks=False)
-    except FileExistsError as exc:
-        raise RedactionRefused("a file is already at the destination") from exc
-    finally:
-        try:
-            os.unlink(str(temporary))
