-class ColumnMap:
-    """For one sheet, which original columns are removed and where the rest land."""
-
-    def __init__(self, removed: Iterable[int]) -> None:
-        self.removed = sorted(set(removed))
-        self._removed = set(self.removed)
-
-    def is_removed(self, index: int) -> bool:
-        return index in self._removed
-
-    def shift(self, index: int) -> int:
-        """New index of an original column that survives."""
-        return index - sum(1 for r in self.removed if r < index)
-
-    def shift_range(self, min_col: int, max_col: int) -> tuple[int, int] | None:
-        """New bounds of an original column span, or None if nothing survives."""
-        kept = [c for c in range(min_col, max_col + 1) if c not in self._removed]
-        if not kept:
-            return None
-        return self.shift(kept[0]), self.shift(kept[-1])
-
-    def touches(self, min_col: int, max_col: int) -> bool:
-        return any(min_col <= r <= max_col for r in self.removed)
